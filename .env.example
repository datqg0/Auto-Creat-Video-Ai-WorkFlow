# ==== LLM ====
GEMINI_API_KEY=your_gemini_api_key_here
# Opus qua provider tương thích Anthropic (base_url cấu hình trong config.yaml)
ANTHROPIC_API_KEY=your_opus_provider_key_here
# Groq Key (miễn phí tại https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
# Pollinations AI Key (lấy tại https://enter.pollinations.ai/keys)
POLLINATIONS_API_KEY=sk_your_pollinations_key_here
# OpenRouter Key (tùy chọn: https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# ==== TTS (tùy chọn) ====
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ==== Ảnh & Video minh họa (tùy chọn) ====
# 1. Google Custom Search (100 ảnh miễn phí/ngày):
#    Tạo API Key tại https://console.cloud.google.com/apis/credentials
#    Tạo Search Engine ID (cx) tại https://programmablesearchengine.google.com/
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# 2. DuckDuckGo / Bing Image Search: Tự động chạy (KHÔNG CẦN KEY, 100% miễn phí) khi không có Google Key!
# 3. Pexels dùng cho CẢ ảnh và footage VIDEO b-roll:
#    Lấy key miễn phí tại https://www.pexels.com/api/
PEXELS_API_KEY=
# 4. HuggingFace Token (miễn phí, tùy chọn cho FLUX.1 sinh ảnh thumbnail / scene):
HF_TOKEN=
# 5. Fal.ai Key (tùy chọn: sinh Text-to-Video diffusion xịn sò Wan 2.1/Kling với credit free khi đăng ký tại https://fal.ai):
FAL_KEY=

# ==== YouTube OAuth ====
# Nội dung file client_secret.json (JSON 1 dòng) — dùng khi deploy trên GitHub Actions
YOUTUBE_CLIENT_SECRET=
# Nội dung token.json đã tạo sẵn ở local (JSON 1 dòng) — để CI upload không cần đăng nhập lại
YOUTUBE_TOKEN=

# ==== Database (Tùy chọn: Neon Serverless PostgreSQL) ====
# Để trống -> tự động dùng SQLite local tại output/state.db.
# Điền Connection String từ https://neon.tech để đồng bộ đa máy & GitHub Actions:
# DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
