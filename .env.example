# ==== LLM ====
GEMINI_API_KEY=your_gemini_api_key_here
# Opus qua provider tương thích Anthropic (base_url cấu hình trong config.yaml)
ANTHROPIC_API_KEY=your_opus_provider_key_here

# ==== TTS (tùy chọn) ====
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ==== YouTube OAuth ====
# Nội dung file client_secret.json (JSON 1 dòng) — dùng khi deploy trên GitHub Actions
YOUTUBE_CLIENT_SECRET=
# Nội dung token.json đã tạo sẵn ở local (JSON 1 dòng) — để CI upload không cần đăng nhập lại
YOUTUBE_TOKEN=
